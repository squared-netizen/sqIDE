# sqterm's zshrc ($PREFIX/etc/zshrc): read by every interactive zsh, before
# your own ~/.zshrc, which can change anything set here. Part of the zsh
# package: an update of sqterm writes it again, so put your own settings in
# ~/.zshrc, not here.
#
# sqterm sets the environment before zsh starts: PREFIX, HOME, PATH (the
# prefix's bin first, then Android's), TMPDIR, TERM=sqterm, LANG.

# History, kept between sessions.
HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_dups hist_reduce_blanks share_history
setopt interactive_comments no_beep

# Emacs keys, and the keys sqterm sends, as its terminfo entry names them.
# The line editor asks for keypad mode while it reads a line, which is what
# those names describe.
bindkey -e
zmodload zsh/terminfo
typeset -A _sqterm_keys
_sqterm_keys=(
  khome beginning-of-line
  kend  end-of-line
  kdch1 delete-char
  kich1 overwrite-mode
  kpp   up-line-or-history
  knp   down-line-or-history
  kcuu1 up-line-or-history
  kcud1 down-line-or-history
  kcub1 backward-char
  kcuf1 forward-char
  kcbt  reverse-menu-complete
)
for _sqterm_name _sqterm_widget in ${(kv)_sqterm_keys}; do
  [[ -n ${terminfo[$_sqterm_name]} ]] && bindkey -- "${terminfo[$_sqterm_name]}" $_sqterm_widget
done
unset _sqterm_keys _sqterm_name _sqterm_widget
if (( ${+terminfo[smkx]} && ${+terminfo[rmkx]} )); then
  function zle-line-init { echoti smkx }
  function zle-line-finish { echoti rmkx }
  zle -N zle-line-init
  zle -N zle-line-finish
fi

# Completion, its cache in the home directory.
autoload -Uz compinit
compinit -d "$HOME/.zcompdump"
zstyle ':completion:*' menu select

# A short prompt: the directory (the home as ~), then % (# for root).
PROMPT='%F{green}%~%f %# '

# The rest is what fish does out of the box. SQTERM_PLAIN=1 in ~/.zshenv
# stops here: the plain shell above.
[[ -n $SQTERM_PLAIN ]] && return

# Moving around: a folder's name alone changes to it; cd keeps a stack of
# where it has been (cd -<Tab> lists it).
setopt auto_cd auto_pushd pushd_ignore_dups pushd_silent

# Colours for files by their kind: ls, sqls, grep and the completion menu.
# Named colours (30-37, 90-97), so they follow sqterm's theme (theme.json):
# folders bright cyan, programs mint, links hot pink, source electric blue,
# archives acid yellow, pictures and media violet, documents lavender,
# dotfiles and build output muted.
export LS_COLORS='rs=0:di=1;96:ln=95:mh=95:pi=33:so=35:do=35:bd=1;33:cd=1;33:or=1;91:mi=1;91:su=1;91:sg=1;91:ca=1;91:tw=1;96:ow=1;96:st=1;96:ex=1;92'\
':*.cpp=94:*.cppm=94:*.hpp=94:*.h=94:*.c=94:*.cc=94:*.cxx=94:*.ixx=94:*.lua=96:*.py=94:*.sh=92:*.zsh=92:*.fish=92:*.rs=94:*.go=94:*.java=94:*.kt=94:*.js=94:*.ts=94'\
':*.json=93:*.toml=93:*.yml=93:*.yaml=93:*.ini=93:*.conf=93:*.xml=93:*.peg=93'\
':*.md=37:*.txt=37:*.rst=37:*.pdf=37:*LICENSE=37:*README=37'\
':*.tar=33:*.tgz=33:*.gz=33:*.xz=33:*.zst=33:*.zip=33:*.bz2=33:*.7z=33:*.sq=1;93:*.apk=1;93:*.deb=33'\
':*.png=35:*.jpg=35:*.jpeg=35:*.gif=35:*.svg=35:*.webp=35:*.ttf=35:*.otf=35:*.mp3=35:*.ogg=35:*.wav=35:*.flac=35:*.mp4=35:*.mkv=35:*.webm=35'\
':*.o=90:*.a=90:*.so=90:*.pcm=90:*.d=90:*.log=90:*.tmp=90:*.part=90:*~=90'
# sqls: ls with icons and colours (sqterm's own; plain ls when not installed).
if (( $+commands[sqls] )); then
  alias ls='sqls' ll='sqls -l' la='sqls -a' lt='sqls --tree'
else
  alias ls='ls --color=auto' ll='ls -lh' la='ls -A'
fi
alias grep='grep --color=auto'

# Completion: case does not matter (unless typed in capitals), a part of a
# name is enough (f.b for foo.bar, then any piece of the name), matches in
# groups under a heading, coloured as ls colours them, and remembered
# between sessions where working them out is slow.
zmodload zsh/complist 2>/dev/null
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'
zstyle ':completion:*:warnings' format '%F{red}no match%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.zcompcache"
setopt complete_in_word always_to_end

# Up and Down search the history for lines that start with what is typed.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
for _sqterm_key in "${terminfo[kcuu1]}" '^[[A' '^[OA'; do
  [[ -n $_sqterm_key ]] && bindkey -- "$_sqterm_key" up-line-or-beginning-search
done
for _sqterm_key in "${terminfo[kcud1]}" '^[[B' '^[OB'; do
  [[ -n $_sqterm_key ]] && bindkey -- "$_sqterm_key" down-line-or-beginning-search
done
unset _sqterm_key

# The prompt: the last command's status when it failed, the directory, and
# inside a git repository its branch (when git is installed).
setopt prompt_subst
# Nerd Font icons (sqterm bundles the symbols): a folder before the path, a
# branch before the git branch, and the prompt's arrow in hot pink; plain
# text when SQTERM_NO_ICONS=1, or in a terminal that is not sqterm.
if [[ -n $SQTERM && -z $SQTERM_NO_ICONS ]]; then
  _sqterm_dir=' ' _sqterm_branch=' ' _sqterm_fail=' ' _sqterm_arrow='❯'  # nf-fa-folder_open, nf-pl-branch, nf-fa-close, ❯
else
  _sqterm_dir='' _sqterm_branch='' _sqterm_fail='' _sqterm_arrow='%#'
fi
if (( $+commands[git] )); then
  autoload -Uz vcs_info add-zsh-hook
  zstyle ':vcs_info:*' enable git
  zstyle ':vcs_info:git:*' formats " %F{13}${_sqterm_branch}%b%f"
  zstyle ':vcs_info:git:*' actionformats " %F{13}${_sqterm_branch}%b%f %F{9}%a%f"
  add-zsh-hook precmd vcs_info
fi
PROMPT="%(?..%F{9}${_sqterm_fail}%?%f )%F{14}${_sqterm_dir}%~%f\${vcs_info_msg_0_} %F{13}${_sqterm_arrow}%f "

# The two plugins, each a package of its own, used when installed. The rest
# of a line offered in grey as it is typed (the right arrow or End takes
# it), from the history, then from completion.
_sqterm_plugins=${PREFIX:-/data/data/dev.squared.sqterm/files/usr}/share/zsh/plugins
if [[ -r $_sqterm_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=200
  source $_sqterm_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
# The line coloured as it is typed: a command that does not exist in red.
# Sourced last, as it asks: it wraps the widgets defined before it.
if [[ -r $_sqterm_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)
  source $_sqterm_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
unset _sqterm_plugins
