# stubgen.awk: a bionic symbol list (libc.map.txt and the like) as what an
# app links against for one API level: a C file of empty definitions
# (mode=c) and the version script that gives them their versions (mode=map).
# sqterm's own, after AOSP's ndkstubgen: the same rules, written for awk.
#
#   awk -v api=28 -v arch=arm64 -v mode=c   -f stubgen.awk libc.map.txt > libc.c
#   awk -v api=28 -v arch=arm64 -v mode=map -f stubgen.awk libc.map.txt > libc.map
#
# A symbol is kept when it is in a public version (not *_PRIVATE or
# *_PLATFORM, not platform-only), for this architecture (no arch tag, or
# this one), introduced at or before `api` (introduced-<arch>= over
# introduced=; on the symbol, else on its version), and not only for the
# platform's own users (apex, llndk, systemapi, future).

function level(v) {
    if (v ~ /^[0-9]+$/) return v + 0
    if (v in codename) return codename[v]
    return 100000  # a codename not known here: not yet released
}

# The tags after '#' on a line, as tag[name] = value ("" for a bare tag).
function read_tags(line,    at, words, n, i, eq) {
    delete tag
    at = index(line, "#")
    if (at == 0) return
    n = split(substr(line, at + 1), words, /[ \t]+/)
    for (i = 1; i <= n; i++) {
        if (words[i] == "") continue
        eq = index(words[i], "=")
        if (eq) tag[substr(words[i], 1, eq - 1)] = substr(words[i], eq + 1)
        else tag[words[i]] = ""
    }
}

# Whether the tags just read leave a symbol (or version) out.
function left_out(introduced_default,    a, any_arch, intro) {
    if (("platform-only" in tag) || ("apex" in tag) || ("llndk" in tag) ||
        ("systemapi" in tag) || ("future" in tag)) return 1
    any_arch = 0
    for (a in arches) if (a in tag) any_arch = 1
    if (any_arch && !(arch in tag)) return 1
    intro = introduced_default
    if (("introduced-" arch) in tag) intro = level(tag["introduced-" arch])
    else if ("introduced" in tag) intro = level(tag["introduced"])
    return intro > api
}

BEGIN {
    split("arm arm64 x86 x86_64 riscv64", list, " ")
    for (i in list) arches[list[i]] = 1
    split("J=16 J-MR1=17 J-MR2=18 K=19 L=21 L-MR1=22 M=23 N=24 N-MR1=25 O=26 " \
          "O-MR1=27 P=28 Q=29 R=30 S=31 Sv2=32 Tiramisu=33 UpsideDownCake=34 " \
          "VanillaIceCream=35 Baklava=36", list, " ")
    for (i in list) { split(list[i], kv, "="); codename[kv[1]] = kv[2] + 0 }
    if (mode == "c") print "/* Generated by sqterm's stubgen.awk: link-time stubs, never run. */"
    in_version = 0
    emitted_any = 0
}

# A version opens: "NAME {", tags maybe after.
/^[ \t]*[A-Za-z0-9_.]+[ \t]*\{/ {
    version = $1
    sub(/\{.*/, "", version)
    gsub(/[ \t]/, "", version)
    read_tags($0)
    version_intro = ("introduced" in tag) ? level(tag["introduced"]) : 0
    if (("introduced-" arch) in tag) version_intro = level(tag["introduced-" arch])
    skip_version = (version ~ /_PRIVATE$/ || version ~ /_PLATFORM$/ || left_out(0))
    in_version = 1
    if (!skip_version && mode == "map") {
        print version " {"
        print "  global:"
    }
    next
}

# A version closes: "}" or "} PARENT;".
in_version && /^[ \t]*\}/ {
    in_version = 0
    if (skip_version) next
    if (mode == "map") {
        if (!emitted_any) { print "  local:"; print "    *;" }
        parent = $0
        sub(/^[ \t]*\}[ \t]*/, "", parent)
        sub(/;.*/, "", parent)
        gsub(/[ \t]/, "", parent)
        if (parent != "" && (parent in kept)) print "} " parent ";"
        else print "};"
    }
    kept[version] = 1
    emitted_any = 1
    next
}

in_version && !skip_version && /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*;/ {
    name = $1
    sub(/;.*/, "", name)
    read_tags($0)
    if (left_out(version_intro)) next
    if (mode == "map") {
        print "    " name ";"
    } else if ("var" in tag) {
        print "int " name " = 0;"
    } else if ("weak" in tag) {
        print "__attribute__((weak)) void " name "(void) {}"
    } else {
        print "void " name "(void) {}"
    }
}
