<?xml version="1.0" encoding="utf-8"?>
<!--
  sqterm — Android manifest.

  This file is YOURS (ownership class: seeded). The generator wrote it once and
  will not overwrite it.

  Two things are deliberately absent:

  <uses-sdk> — minSdkVersion and targetSdkVersion are passed to aapt2 by the
  build (mk/squared_generated.mk), so `make apk SQ_MIN_SDK=21` retargets the
  project without editing a file. Declaring them here as well would create two
  sources of truth, and aapt2 would take this one.

  android:debuggable — set by the build (aapt2's debug mode) for DEV_LOG and
  CONSOLE builds, never for plain ones. (Not spelled out here: two hyphens in
  a row end an XML comment early, and aapt2 rejects the file.) Committing it would ship a
  debuggable release.

  There is no Java in this project. The activity, dev.squared.SquaredActivity,
  is a NativeActivity from squared's shim dex (about 1 KB, generated with no
  Java: squared/tools/dexgen), whose one method of its own takes the text a
  keyboard sends whole, a paste (sq_android/entry.cpp). With BACKGROUND=1
  (running in the background, app.keep_running) the build gives the APK a
  copy of this file with squared's service in it; this file stays as it is
  (sq_android/README.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="dev.squared.sqterm"
          android:versionCode="1"
          android:versionName="0.1.0">

    <!-- GLES 3.0. Declared so the Play Store filters devices that cannot run
         it; harmless when a rendering kit is not in use. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <!-- pkg (12.5) installs a package from a file in shared storage (your
         Download folder) and, asked to consume it, deletes it after. sqterm
         targets SDK 28, so these give the old full access to shared storage.
         Granted once by hand: Settings, Apps, sqterm, Permissions, Files. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- The network, for what the shell runs: pkg update, upgrade and install
         NAME download from sqterm's GitHub release through curl, and curl,
         git or ssh are a terminal's to run. A normal permission: granted at
         install, nothing to ask. (Before 2026-11-18 only DEV_LOG and CONSOLE
         builds had it.) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- sqterm-install and sqterm-uninstall (docs/install-api.md): installing
         and removing apps through PackageInstaller, which Android confirms
         with the person each time. The first install sends them to Settings,
         "Install unknown apps", to allow sqterm once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true">

        <!-- dev.squared.SquaredActivity: a NativeActivity from squared's shim
             dex whose dispatchKeyEvent takes the text a keyboard sends whole
             (a paste, CleverKeys' clipboard keys) and the Paste key, which the
             NDK cannot read (sq_android/entry.cpp). -->
        <activity
            android:name="dev.squared.SquaredActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode">

            <!-- Tells NativeActivity which library to dlopen. Must match the
                 SQ_PROJECT name the build produces. -->
            <meta-data android:name="android.app.lib_name" android:value="sqterm" />

            <!-- Which function in it starts the activity: squared_on_create
                 (sq_android/entry.cpp), on Android's UI thread, which gives
                 the native thread a way to that thread (hiding the system
                 bars needs it) and then starts the glue. Without this line
                 the glue starts alone: the bars stay, and the rest works. -->
            <meta-data android:name="android.app.func_name" android:value="squared_on_create" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- dev.squared.ResultReceiver: where Android sends an install's or an
             uninstall's result (PackageInstaller's IntentSender), whose
             onReceive is native (sq_android/api.cpp). Not exported: only
             the PendingIntent sqterm made can reach it. -->
        <receiver
            android:name="dev.squared.ResultReceiver"
            android:exported="false" />
    </application>
</manifest>
